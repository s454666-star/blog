{
  "manifest_version": 3,
  "name": "Star 台指期 TradingView 即時橋接",
  "version": "1.1.0",
  "description": "共用目前 Chrome TradingView 頁面的行情連線，安全地交給本機台指期 Redis worker。",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://tw.tradingview.com/*",
    "http://127.0.0.1:18765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tw.tradingview.com/*"
      ],
      "js": [
        "page-quote-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://tw.tradingview.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
